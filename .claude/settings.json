{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-vibe-run.mjs\"" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-project-rule.mjs\"" } ] }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-python.mjs\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-guard.py\"" } ]
      }
    ]
  }
}
